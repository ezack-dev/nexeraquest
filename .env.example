# NexeraQuest Environment Configuration

# Database Connection — Neon Postgres (pooled). Same URL locally and on Vercel.
# Get it: Neon dashboard → steep-sea-21499804 → Connection Details → pooled.
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require&channel_binding=require"

# JWT Secret for Session Authentication & RBAC Tokens
JWT_SECRET="nexeraquest_dev_jwt_secret_change_in_production_key_443"

# Telegram Bot Credentials (Obtain from @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="NexeraQuestBot"
TELEGRAM_MINI_APP_URL="https://t.me/NexeraQuestBot/app"

# Application Settings
SANDBOX_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public HTTPS URL of the deployed web app (tunnel or hosting).
# BotFather Mini App URL + Telegram web_app buttons must point here —
# Telegram refuses http://localhost and non-HTTPS origins.
NEXT_PUBLIC_MINI_APP_URL=""
NODE_ENV="development"

# Object Storage Abstraction (S3 / Cloudflare R2 / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="nexeraquest-proofs"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
