{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@nexeraquest/types": ["./packages/types/src/index.ts"],
      "@nexeraquest/config": ["./packages/config/src/index.ts"],
      "@nexeraquest/database": ["./packages/database/src/index.ts"],
      "@nexeraquest/ledger": ["./packages/ledger/src/index.ts"],
      "@nexeraquest/verification": ["./packages/verification/src/index.ts"],
      "@nexeraquest/fraud": ["./packages/fraud/src/index.ts"],
      "@nexeraquest/notifications": ["./packages/notifications/src/index.ts"],
      "@nexeraquest/auth": ["./packages/auth/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "workers/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
